{
    "name": "grep2file",
    "displayName": "grep2file",
    "description": "grep word and output result to file",
    "version": "0.6.0",
    "publisher": "yuna611d",
    "license": "MIT",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "grep",
        "search",
        "find in files",
        "csv",
        "json"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.grepResult2File",
                "title": "Grep to File"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Grep2File",
            "properties": {
                "grep2file.exclude": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "bin",
                        "dll",
                        "sln"
                    ],
                    "description": "Files which has file extensions listed up here are ignored. Each entry is a whole file extension, not a pattern, so \"js\" does not also ignore .json files."
                },
                "grep2file.ignoreHiddenFile": {
                    "type": "boolean",
                    "default": true,
                    "description": "Hidden files whose file name starts with period are ignored if checked"
                },
                "grep2file.outputFileName": {
                    "type": "string",
                    "default": "grep2File.g2f",
                    "description": "Name of result file"
                },
                "grep2file.outputContentFormat": {
                    "type": "string",
                    "default": "txt",
                    "description": "File format of result file. You can opt from txt, csv, tsv or json."
                },
                "grep2file.searchAllEncodings": {
    "type": "boolean",
    "default": false,
    "description": "Search every file under UTF-8, UTF-16 and the Japanese encodings (Shift-JIS, EUC-JP), and report a line that matches under any of them. Use this when a workspace mixes encodings and you would rather not configure files.encoding; files.autoGuessEncoding is ignored while it is on. Each file is decoded several times, so searches are slower."
   },
   "grep2file.outputTitle": {
                    "type": "boolean",
                    "default": true,
                    "description": "Search configuration is outputted if checked."
                },
                "grep2file.useEditorExcludes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Leave out the files and folders the editor is already told to leave out, by honouring the files.exclude and search.exclude settings. Uncheck to search everything under the workspace folders, including node_modules and build output."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "package": "npx --yes @vscode/vsce package",
        "package:ls": "npx --yes @vscode/vsce ls"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.4.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.37.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.46.0"
    },
    "overrides": {
        "diff": "^8.0.3",
        "serialize-javascript": "^7.0.5"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/GrepExtension.git"
    },
    "bugs": {
        "url": "https://github.com/yuna611d/GrepExtension/issues"
    },
    "homepage": "https://github.com/yuna611d/GrepExtension#readme"
}
