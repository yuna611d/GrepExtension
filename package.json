{
    "name": "grep2file",
    "displayName": "grep2file",
    "description": "grep word and output result to file",
    "version": "0.6.0",
    "publisher": "yuna611d",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.grepResult2File",
                "title": "Grep to File"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Grep2File",
            "properties": {
                "grep2file.exclude": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": [
                        "bin",
                        "dll",
                        "sln"
                    ],
                    "description": "Files which has file extensions listed up here are ignored."
                },
                "grep2file.ignoreHiddenFile": {
                    "type": "boolean",
                    "default": true,
                    "description": "Hidden files whose file name starts with period are ignored if checked"
                },
                "grep2file.outputFileName": {
                    "type": "string",
                    "default": "grep2File.g2f",
                    "description": "Name of result file"
                },
                "grep2file.outputContentFormat": {
                    "type": "string",
                    "default": "txt",
                    "description": "File format of result file. You can opt from txt, csv, tsv or json."
                },
                "grep2file.outputTitle": {
                    "type": "boolean",
                    "default": true,
                    "description": "Search configuration is outputted if checked."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.4.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.37.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.0"
    },
    "overrides": {
        "diff": "^8.0.3",
        "serialize-javascript": "^7.0.5"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/GrepExtension.git"
    }
}
